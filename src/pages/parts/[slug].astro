---
import Base from '../../layouts/Base.astro';
import SourceLinks from '../../components/SourceLinks.astro';
import Provenance from '../../components/Provenance.astro';
import FactLedger from '../../components/FactLedger.astro';
import { loadEntities, loadEntity, fact, factStr, factNum } from '../../lib/facts';
import { buildParts } from '../../lib/sizing';
import { fmtGb, fmtUsd, partImage } from '../../lib/builds';

// A part's page: reached from the builds it is in, not listed on its own.
export async function getStaticPaths() {
  return loadEntities('part').map(p => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props;
const part = loadEntity('part', slug)!;
const cls = factStr(part, 'class');
const image = partImage(part);
const released = factStr(part, 'released');
const priceFact = fact(part, 'price.new_usd');
const price = factNum(part, 'price.new_usd');

const usedIn = loadEntities('build')
  .map(b => ({ build: b, row: buildParts(b).find(p => p.slug === slug) }))
  .filter(r => r.row !== undefined);

const PLACEMENT: Record<string, string> = { desk: 'On a desk', deskside: 'Beside a desk', rack: 'In a server rack' };
const fmtDate = (d: string | null) => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : null;

// Each spec with its fact, so every value carries where it came from.
const specs = [
  { label: 'Memory', key: 'memory_gb', show: (v: number) => fmtGb(v) },
  { label: 'GPU memory', key: 'gpu_memory_gb', show: (v: number) => fmtGb(v) },
  { label: 'Memory bandwidth', key: 'memory_bandwidth_gbps', show: (v: number) => `${v.toLocaleString('en-US')} GB/s` },
  { label: 'BF16 compute (dense)', key: 'bf16_tflops', show: (v: number) => `${v.toLocaleString('en-US')} TFLOPS` },
  { label: 'GPUs', key: 'gpu_count', show: (v: number) => String(v) },
  { label: 'Power', key: 'power_w', show: (v: number) => `${v.toLocaleString('en-US')} W` },
]
  .map(s => ({ ...s, value: factNum(part, s.key), fact: fact(part, s.key) }))
  .filter(s => s.value !== null);
const placement = factStr(part, 'placement');
const formFactor = factStr(part, 'form_factor');
---

<Base
  title={`${part.name} — Builds`}
  description={`${part.name}: specs, price and the builds it is part of.`}
>
  <main class="max-w-3xl w-full mx-auto px-4 sm:px-6 py-10">

    <a href="/builds" class="inline-flex items-center gap-1.5 text-sm text-nord-500 hover:text-nord-300 transition-colors mb-8">
      <span>←</span> Builds
    </a>

    {image && (
      <div class="mb-6 bg-nord-900 border border-nord-800 rounded-lg overflow-hidden">
        <img src={image} alt={part.name} class="w-full h-auto max-h-80 object-contain" />
      </div>
    )}

    <header class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-nord-100 leading-tight">{part.name}</h1>
      <p class="text-nord-500 mt-1 text-sm">
        {[factStr(part, 'maker'), cls === 'system' ? 'Complete system' : 'GPU card', released ? `Released ${fmtDate(released)}` : null].filter(Boolean).join(' · ')}
      </p>
      <div class="mt-4">
        <SourceLinks entity={part} keys={['snapshot.maker', 'snapshot.techpowerup', 'snapshot.wikipedia']} />
      </div>
    </header>

    <section class="mb-8">
      <h2 class="text-lg font-semibold text-nord-100 mb-3">Specs</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        {specs.map(s => (
          <div class="px-3 py-2 rounded bg-nord-900 border border-nord-800">
            <dt class="text-xs text-nord-500">{s.label}</dt>
            <dd class="text-nord-200 font-mono">{s.show(s.value!)}</dd>
            {s.fact && <dd class="mt-1"><Provenance fact={s.fact} /></dd>}
          </div>
        ))}
        {(placement || formFactor) && (
          <div class="px-3 py-2 rounded bg-nord-900 border border-nord-800">
            <dt class="text-xs text-nord-500">{placement ? 'Where it goes' : 'Form factor'}</dt>
            <dd class="text-nord-200">{placement ? (PLACEMENT[placement] ?? placement) : formFactor}</dd>
          </div>
        )}
      </dl>
      {specs.length === 0 && <p class="text-sm text-nord-500">Specs not yet researched.</p>}
    </section>

    {priceFact && (
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-nord-100 mb-3">Price</h2>
        <div class="px-3 py-2 rounded bg-nord-900 border border-nord-800 text-sm inline-block min-w-[12rem]">
          <div class="text-nord-200 font-mono">{price !== null ? fmtUsd(price) : 'Priced on quote'}</div>
          <div class="mt-1"><Provenance fact={priceFact} /></div>
        </div>
        {priceFact.quote && <p class="text-xs text-nord-500 mt-2">The listing says: “{priceFact.quote}”</p>}
      </section>
    )}

    {usedIn.length > 0 && (
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-nord-100 mb-3">In these builds</h2>
        <div class="space-y-2">
          {usedIn.map(({ build, row }) => (
            <a href={`/builds/${build.slug}`} class="flex items-center justify-between gap-3 px-4 py-3 rounded-lg bg-nord-900 border border-nord-800 hover:border-nord-600 transition-colors">
              <span class="text-sm text-nord-100">{build.name}</span>
              <span class="text-xs text-nord-500 font-mono">{row!.quantity}×</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <FactLedger entity={part} />

    {part.references.length > 0 && (
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-nord-100 mb-3">References</h2>
        <ul class="space-y-2">
          {part.references.map(ref => (
            <li class="text-sm text-nord-400 leading-relaxed">
              <a href={ref.url} target="_blank" rel="noopener noreferrer" class="text-frost-400 hover:text-frost-300 hover:underline">{ref.title}</a>
              {ref.author ? ` — ${ref.author}` : ''}
            </li>
          ))}
        </ul>
      </section>
    )}

  </main>
</Base>
