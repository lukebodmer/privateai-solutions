---
import GliderMark from './GliderMark.astro';

const navLinks = [
  { href: '/', label: 'Neuman' },
  { href: '/docs', label: 'Docs' },
  { href: '/download', label: 'Download' },
  { href: '/ecosystem', label: 'Ecosystem', also: ['/models', '/builds', '/harnesses', '/companies', '/news'] },
  { href: '/blog', label: 'Blog' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname;
const under = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
const isActive = ({ href, also = [] }: { href: string; also?: string[] }) => [href, ...also].some(under);
---

<header class="border-b border-nord-800 bg-nord-950/90 backdrop-blur sticky top-0 z-50">
  <nav class="max-w-screen-2xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <a href="/" aria-label="Private AI Solutions, home" class="group flex items-center gap-2.5 whitespace-nowrap">
      <GliderMark size={20} animate="hover" class="text-frost-400 shrink-0" />
      <!-- The wordmark, set like the page headlines: light, tight, with the
           frost gradient on its last word. -->
      <span class="text-[17px] leading-none tracking-[-0.025em]" aria-hidden="true">
        <span class="font-medium text-nord-50 transition-colors group-hover:text-white">Private AI</span>
        <span class="font-light bg-gradient-to-r from-frost-300 to-frost-500 bg-clip-text text-transparent">Solutions</span>
      </span>
    </a>

    <ul class="hidden lg:flex items-center gap-1">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded text-sm transition-colors ${
              isActive(link)
                ? 'text-frost-400 bg-frost-400/10'
                : 'text-nord-400 hover:text-nord-100 hover:bg-nord-800'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      id="nav-toggle"
      type="button"
      class="lg:hidden -mr-2 p-2 rounded text-nord-400 hover:text-nord-100 hover:bg-nord-800 transition-colors"
      aria-controls="nav-menu"
      aria-expanded="false"
      aria-label="Menu"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
        <path d="M3 5h14M3 10h14M3 15h14" />
      </svg>
    </button>
  </nav>
</header>

<!-- Side panel for narrow screens. Outside <header>: its backdrop-blur
     would make `fixed` position against the header, not the viewport. -->
<div id="nav-menu" class="group lg:hidden" data-open="false">
  <div data-nav-close
    class="fixed inset-0 z-[60] bg-black/60 opacity-0 pointer-events-none transition-opacity duration-200 group-data-[open=true]:opacity-100 group-data-[open=true]:pointer-events-auto"></div>
  <aside
    class="fixed top-0 right-0 z-[70] h-full w-72 max-w-[85vw] bg-nord-950 border-l border-nord-800 flex flex-col translate-x-full transition-transform duration-200 group-data-[open=true]:translate-x-0"
    aria-label="Site navigation"
  >
    <div class="h-14 px-4 flex items-center justify-between border-b border-nord-800 shrink-0">
      <span class="text-xs uppercase tracking-wider text-nord-500">Menu</span>
      <button data-nav-close type="button" aria-label="Close menu"
        class="-mr-2 p-2 rounded text-nord-400 hover:text-nord-100 hover:bg-nord-800 transition-colors">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <path d="M5 5l10 10M15 5L5 15" />
        </svg>
      </button>
    </div>
    <ul class="flex-1 overflow-y-auto p-2 space-y-0.5">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`block px-3 py-2.5 rounded text-sm transition-colors ${
              isActive(link)
                ? 'text-frost-400 bg-frost-400/10'
                : 'text-nord-300 hover:text-nord-100 hover:bg-nord-800'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </aside>
</div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  function setOpen(open: boolean) {
    if (!menu || !toggle) return;
    menu.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setOpen(true));
  menu?.querySelectorAll('[data-nav-close]').forEach(el => el.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') setOpen(false); });
  // Widening past the breakpoint hides the panel; don't leave the page scroll-locked.
  matchMedia('(min-width: 1024px)').addEventListener('change', e => { if (e.matches) setOpen(false); });
</script>
