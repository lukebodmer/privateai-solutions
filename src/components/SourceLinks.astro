---
/**
 * Renders a row of logo-bearing link chips derived from an entity's
 * `snapshot.*` facts. Each chip corresponds to one snapshot fact key
 * (`snapshot.huggingface_card`, `snapshot.github`, ...). Passing an
 * `officialLogo` substitutes the entity's own logo for the "official"
 * chip (used on company pages).
 *
 * Reads directly from the fact system — no separate `sources` array.
 * A snapshot fact whose value is null / N/A / missing gets no chip.
 */
import type { Entity } from '../lib/facts';
import { factStr } from '../lib/facts';

interface Props {
  entity: Entity;
  /** Snapshot fact keys to render, in display order (e.g.
   *  `['snapshot.huggingface_card', 'snapshot.github']`). Missing / N/A
   *  keys drop out. */
  keys: string[];
  /** Optional logo to substitute in for the `snapshot.official` chip
   *  (typically the entity's own logo, used on company detail pages). */
  officialLogo?: string;
}

const { entity, keys, officialLogo } = Astro.props;

interface Chip {
  key: string;
  url: string;
}
const chips: Chip[] = keys
  .map(k => {
    const url = factStr(entity, k);
    return url ? { key: k, url } : null;
  })
  .filter((c): c is Chip => c !== null);

/** Display label for each snapshot key. Central so callers don't
 *  hard-code names. Anything unmapped falls back to the trailing part
 *  of the key. */
const KEY_LABELS: Record<string, string> = {
  'snapshot.official': 'Website',
  'snapshot.website': 'Website',
  'snapshot.wikipedia': 'Wikipedia',
  'snapshot.huggingface_card': 'HuggingFace',
  'snapshot.huggingface_org': 'HuggingFace',
  'snapshot.hf_config': 'HF config',
  'snapshot.github': 'GitHub',
  'snapshot.github_org': 'GitHub',
  'snapshot.docs': 'Docs',
  'snapshot.package': 'Package',
  'snapshot.unsloth_gguf': 'Unsloth GGUF',
  'snapshot.bartowski_gguf': 'bartowski GGUF',
  'snapshot.official_announcement': 'Announcement',
  'snapshot.maker': 'Maker',
  'snapshot.techpowerup': 'TechPowerUp',
};

/** Icon family — driven by a coarse `look` derived from the key. Keeps
 *  the icon switch below small. */
function iconLookFor(key: string): string {
  if (key === 'snapshot.huggingface_card' || key === 'snapshot.huggingface_org' || key === 'snapshot.hf_config') return 'hf';
  if (key === 'snapshot.github' || key === 'snapshot.github_org') return 'github';
  if (key === 'snapshot.wikipedia') return 'wiki';
  if (key === 'snapshot.docs') return 'docs';
  if (key === 'snapshot.package') return 'package';
  return 'globe';
}
---

{chips.length > 0 && (
  <div class="flex flex-wrap gap-2">
    {chips.map(({ key, url }) => {
      const look = iconLookFor(key);
      const label = KEY_LABELS[key] ?? key.replace(/^snapshot\./, '');
      return (
        <a href={url} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs border bg-nord-800 text-nord-300 border-nord-700 hover:border-nord-500 hover:text-nord-100 transition-colors">
          {key === 'snapshot.official' && officialLogo ? (
            <img src={officialLogo} alt="" class="w-3.5 h-3.5 rounded shrink-0" />
          ) : look === 'hf' ? (
            <svg width="14" height="14" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="16" cy="16" r="14" fill="#FFD21E" />
              <circle cx="11" cy="14" r="2" fill="#3A3B3D" />
              <circle cx="21" cy="14" r="2" fill="#3A3B3D" />
              <path d="M10 19c1.5 2.5 4 4 6 4s4.5-1.5 6-4" stroke="#3A3B3D" stroke-width="2" stroke-linecap="round" fill="none" />
            </svg>
          ) : look === 'github' ? (
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
          ) : look === 'wiki' ? (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M23.94 5.65v.66c-1.03.09-1.68.34-1.95.75-.27.4-.63 1.14-1.09 2.22l-5.5 13.14h-.7L10.7 12.6l-4.29 9.82h-.7L.86 8.98C.45 8.02.12 7.4-.13 7.12c-.24-.27-.68-.44-1.31-.51v-.66h5.62v.66c-.65.02-1.07.11-1.27.28-.2.16-.3.36-.3.6 0 .21.16.68.5 1.4l3.06 7.32 2.44-5.63-.87-2.05c-.36-.86-.65-1.4-.86-1.61-.22-.22-.6-.34-1.14-.34v-.66h5.68v.66c-.63.03-1.05.13-1.24.3-.19.17-.29.36-.29.57 0 .21.11.5.32 1.05l1.14 2.98 1.8-4.16c.27-.63.4-1.07.4-1.31 0-.2-.11-.44-.34-.61-.23-.16-.66-.26-1.31-.28v-.66h4.51v.66c-.7.09-1.19.29-1.47.6-.28.31-.6.85-.97 1.65l-3.65 8.44 2.85 6.63 4.75-11.16c.32-.75.48-1.32.48-1.71 0-.32-.14-.6-.42-.83-.28-.24-.7-.36-1.27-.36v-.66h4.85z" />
            </svg>
          ) : look === 'docs' ? (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
          ) : look === 'package' ? (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M16.5 9.4l-9-5.19M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
              <line x1="3.27" y1="6.96" x2="12" y2="12.01" />
              <line x1="12" y1="22.08" x2="12" y2="12" />
            </svg>
          ) : (
            /* Generic globe for anything else (website / blog / maker / etc). */
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <line x1="2" y1="12" x2="22" y2="12" />
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
          )}
          <span>{label}</span>
        </a>
      );
    })}
  </div>
)}
