// Cloudflare Workers: static assets, plus the one script that takes the contact
// form (src/worker.js). Pages are served straight from ./dist; the Worker runs
// only for /api/*, so a page request never touches it.
// Workers Builds reads this file; the Worker's name in the dashboard must
// match `name` here or the build fails.
{
  "name": "privateai-solutions",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-20",
  // The site answers on the Custom Domain alone. Without this, a deploy
  // re-enables <name>.<account>.workers.dev, undoing a dashboard Disable.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Form submissions are emailed here. `destination_address` refuses any other
  // recipient, so the binding can never be used to send somewhere else.
  "send_email": [
    { "name": "CONTACT", "destination_address": "lukejbodmer@gmail.com" }
  ],
  // A deploy creates the Custom Domain and its DNS record if it is not there.
  "routes": [
    { "pattern": "privateai.solutions", "custom_domain": true }
  ]
}
