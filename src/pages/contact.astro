---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base
  title="Contact — Private AI Solutions"
  description="Get in touch with Private AI Solutions for consulting, hardware builds, or AI architecture questions."
>
  <main class="max-w-2xl w-full mx-auto px-4 sm:px-6 py-16">

    <PageHeader eyebrow="Get in touch" title="Contact" wide class="mb-10">
      <p>Describe your project or question below, and we'll get back to you as soon as we can.</p>
      <p class="mt-3 inline-flex items-center gap-1.5 text-xs text-nord-500">
        <svg class="w-3.5 h-3.5 text-frost-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 14s4.5-4.2 4.5-7.5a4.5 4.5 0 0 0-9 0C3.5 9.8 8 14 8 14Z" /><circle cx="8" cy="6.5" r="1.5" /></svg>
        Based in Los Angeles, California
      </p>
    </PageHeader>

    <form
      action="/api/contact"
      method="post"
      class="space-y-5"
    >
      <!-- A field no visitor sees; scripts that fill it are answered like a person. -->
      <div class="absolute -left-[9999px] w-px h-px overflow-hidden" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div>
        <label for="name" class="block text-sm font-medium text-nord-300 mb-1.5">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          placeholder="Your name"
          class="w-full bg-nord-900 border border-nord-700 rounded-lg px-4 py-2.5 text-nord-200 placeholder-nord-600 focus:outline-none focus:border-frost-600 focus:ring-1 focus:ring-frost-600/30 transition-colors"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-nord-300 mb-1.5">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          placeholder="you@company.com"
          class="w-full bg-nord-900 border border-nord-700 rounded-lg px-4 py-2.5 text-nord-200 placeholder-nord-600 focus:outline-none focus:border-frost-600 focus:ring-1 focus:ring-frost-600/30 transition-colors"
        />
      </div>

      <div>
        <label for="subject" class="block text-sm font-medium text-nord-300 mb-1.5">
          What are you working on?
        </label>
        <select
          id="subject"
          name="subject"
          class="w-full bg-nord-900 border border-nord-700 rounded-lg px-4 py-2.5 text-nord-200 focus:outline-none focus:border-frost-600 focus:ring-1 focus:ring-frost-600/30 transition-colors"
        >
          <option value="AI Product Build">AI Product Build</option>
          <option value="Local Hardware">Local Hardware (procurement / install)</option>
          <option value="Architecture Consulting">Architecture Consulting</option>
          <option value="Other">Other / General Question</option>
        </select>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-nord-300 mb-1.5">Message</label>
        <textarea
          id="message"
          name="body"
          rows="6"
          required
          placeholder="Describe your project, constraints, timeline, or question..."
          class="w-full bg-nord-900 border border-nord-700 rounded-lg px-4 py-2.5 text-nord-200 placeholder-nord-600 focus:outline-none focus:border-frost-600 focus:ring-1 focus:ring-frost-600/30 transition-colors resize-y"
        ></textarea>
      </div>

      <button
        type="submit"
        class="inline-block px-5 py-2 rounded-full bg-frost-500 hover:bg-frost-400 text-nord-950 text-sm font-semibold shadow-[0_0_24px_-6px_rgba(136,192,208,0.6)] transition-colors"
      >
        Send message
      </button>
    </form>

    <p class="mt-6 text-nord-500 text-sm">
      Prefer email directly?
      <a href="mailto:info@privateai.solutions" class="text-frost-400 hover:underline">
        info@privateai.solutions
      </a>
    </p>

  </main>
</Base>
