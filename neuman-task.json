{
  "name": "privateai.solutions update",
  "workspace": "/home/lj/projects/privateai_solutions",
  "run_root": "/data/privateai-runs",
  "inputs": [
    {
      "name": "kind",
      "description": "queued: the oldest request from the dashboard. sweep: prices, re-checks, new releases.",
      "values": ["queued", "sweep"],
      "required": true,
      "default": "queued"
    }
  ],
  "steps": [
    {
      "kind": "run",
      "name": "prepare",
      "argv": ["nix", "develop", "-c", "pnpm", "task:prepare"],
      "timeout_s": 900
    },
    {
      "kind": "agent",
      "name": "research",
      "instruction": "Read brief.md in your working directory and follow it.",
      "model": "DeepSeek-V4.1-Flash-1017",
      "reasoning": null,
      "envelope": {
        "tools": ["fs_read", "fs_list", "fs_write", "web_fetch"],
        "files_read": ["$RUN_DIR"],
        "files_write": ["$RUN_DIR"],
        "network": "any",
        "models": ["DeepSeek-V4.1-Flash-1017"],
        "max_iterations": 200
      }
    },
    {
      "kind": "run",
      "name": "check",
      "argv": ["nix", "develop", "-c", "pnpm", "check"],
      "timeout_s": 1800,
      "run_if": "ok_or_budget"
    }
  ],
  "schedule": {
    "kind": "daily",
    "time": "10:00",
    "timezone": "America/Los_Angeles",
    "inputs": {"kind": "sweep"}
  },
  "outputs": ["claims.json", "report.md", "result.json"],
  "enabled": true
}
